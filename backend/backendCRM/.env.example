# Copy this file to `.env` and fill real values. Never commit `.env`.

# Django Core
SECRET_KEY=replace-with-output-of-get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=crm_db
DB_USER=crm_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# CORS — comma-separated full origins, NO trailing slash
CORS_ALLOWED_ORIGINS=http://localhost:5173

# CSRF trusted origins
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# HTTPS-only flags (turn on in production behind TLS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
