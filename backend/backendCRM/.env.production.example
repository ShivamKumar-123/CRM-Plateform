# ════════════════════════════════════════════════════════════════
# CRM SUITE — PRODUCTION .env template
#
# Copy this to .env on your production server and fill ALL placeholders.
# Every line marked  ⚠️  MUST be changed before going live.
# ════════════════════════════════════════════════════════════════


# ─── Django core ─────────────────────────────────────────────────

# ⚠️  Generate a fresh key for production. DO NOT reuse the dev key.
#     python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=__GENERATE_A_FRESH_50_CHAR_KEY__

# MUST be False in production. True leaks SQL queries + stack traces.
DEBUG=False

# ⚠️  Your actual production hostnames. No http://, no trailing slash, no port.
ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com


# ─── PostgreSQL ──────────────────────────────────────────────────

# ⚠️  Production DB credentials. Use a managed service if possible (RDS, Cloud SQL, Crunchy, Neon).
DB_NAME=crm_prod
DB_USER=crm_app
DB_PASSWORD=__USE_A_30_CHAR_RANDOM_PASSWORD__
DB_HOST=__your-db-host.region.rds.amazonaws.com__
DB_PORT=5432


# ─── CORS / CSRF ─────────────────────────────────────────────────
# ⚠️  HTTPS only, your actual production frontend origin(s).
CORS_ALLOWED_ORIGINS=https://crm.yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://crm.yourdomain.com,https://www.yourdomain.com


# ─── HTTPS / security toggles (ALL true in production) ───────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# 1 year HSTS. Start at 60s if you're worried, then ramp up.
SECURE_HSTS_SECONDS=31536000


# ─── JWT — short access, reasonable refresh ──────────────────────
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14


# ─── Email (transactional) ───────────────────────────────────────
# Recommended: a transactional provider like SendGrid, Postmark, AWS SES,
# Mailgun, or Resend. Avoid raw Gmail in production.
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=__SENDGRID_API_KEY__
DEFAULT_FROM_EMAIL=CRM Suite <noreply@yourdomain.com>


# ─── Razorpay (billing) ──────────────────────────────────────────
# Get from https://dashboard.razorpay.com/app/keys
# Use LIVE keys here, TEST keys in staging.
RAZORPAY_KEY_ID=rzp_live___________________
RAZORPAY_KEY_SECRET=__SET_FROM_DASHBOARD__
RAZORPAY_WEBHOOK_SECRET=__SET_FROM_DASHBOARD__


# ─── WhatsApp Business Cloud API ─────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=


# ─── Redis (Celery broker for automation engine) ─────────────────
# Use Upstash, ElastiCache, or self-hosted Redis with auth + TLS.
REDIS_URL=rediss://default:__password__@__host__:6379/0
CELERY_BROKER_URL=rediss://default:__password__@__host__:6379/0


# ─── Sentry (error monitoring) ───────────────────────────────────
SENTRY_DSN=https://__public_key__@__org__.ingest.sentry.io/__project_id__
SENTRY_ENVIRONMENT=production


# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=WARNING


# ═════════════════════════════════════════════════════════════════
# DEPLOYMENT CHECKLIST — verify before going live
# ═════════════════════════════════════════════════════════════════
#
#  [ ] SECRET_KEY regenerated (50 chars, not the dev one)
#  [ ] DEBUG=False
#  [ ] ALLOWED_HOSTS contains ONLY your real domains (no localhost)
#  [ ] DB_PASSWORD is 20+ char random
#  [ ] DB is not exposed to the public internet
#  [ ] CORS_ALLOWED_ORIGINS contains ONLY https:// origins
#  [ ] All 3 SECURE_ toggles = True
#  [ ] HTTPS certificate installed (nginx / Caddy / Cloudflare full-strict)
#  [ ] python manage.py collectstatic --noinput
#  [ ] python manage.py migrate
#  [ ] python manage.py createsuperuser  (then immediately enable 2FA on it)
#  [ ] gunicorn running behind nginx, NOT manage.py runserver
#  [ ] Daily database backups configured (pg_dump → S3 / B2 cron)
#  [ ] Sentry receiving events (test with `python manage.py shell -c "raise Exception('sentry test')"`)
#  [ ] Firewall: only ports 80, 443, 22 (with key auth) open
#  [ ] fail2ban or rate-limit at nginx for /api/token/ and /admin/
#  [ ] Verify HSTS header in response: `curl -I https://api.yourdomain.com/admin/`
#  [ ] Run `python manage.py check --deploy` — fix every warning
#
# ═════════════════════════════════════════════════════════════════
