# Cross-platform line-ending normalisation.
# All text files get LF in the repo regardless of OS.
# Stops the "LF will be replaced by CRLF" warnings on Windows.

# Default — auto-detect text files, normalise to LF in repo
* text=auto eol=lf

# Source code
*.py     text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf

# Web / config
*.html   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.xml    text eol=lf
*.svg    text eol=lf

# Docs + env
*.md     text eol=lf
*.txt    text eol=lf
.env*    text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Shell scripts must stay LF (won't run on Linux otherwise)
*.sh     text eol=lf

# Windows-only scripts keep CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary — never touch
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.pdf    binary
*.zip    binary
*.tar    binary
*.gz     binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.otf    binary

# Lockfiles — leave to tooling
package-lock.json text eol=lf -diff
yarn.lock         text eol=lf -diff
